<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SHIPOVER</title>

<style>
*{
  box-sizing:border-box;
  margin:0;
  padding:0;
  font-family:Arial,sans-serif;
}

body{
  background:#f4f7fb;
  color:#172033;
}

header{
  background:linear-gradient(135deg,#061b35,#0877ff);
  color:white;
  text-align:center;
  padding:25px 15px;
}

.logo{
  font-size:36px;
  font-weight:800;
  letter-spacing:3px;
}

.disclaimer{
  background:#fff3cd;
  color:#705400;
  padding:12px;
  text-align:center;
  font-size:14px;
}

/* SLIDER */
.slider{
  width:100%;
  height:280px;
  overflow:hidden;
  position:relative;
}

.slides{
  display:flex;
  width:300%;
  height:100%;
  animation:slide 12s infinite;
}

.slide{
  width:33.333%;
  flex-shrink:0;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:30px;
  font-weight:bold;
  color:white;
}

.slide:nth-child(1){
  background:linear-gradient(135deg,#0066ff,#00b4ff);
}
.slide:nth-child(2){
  background:linear-gradient(135deg,#071a2b,#1455d9);
}
.slide:nth-child(3){
  background:linear-gradient(135deg,#008f72,#00c9a7);
}

@keyframes slide{
  0%,28%{transform:translateX(0);}
  33%,61%{transform:translateX(-33.333%);}
  66%,94%{transform:translateX(-66.666%);}
  100%{transform:translateX(0);}
}

.container{
  max-width:1000px;
  margin:auto;
  padding:25px 15px;
}

.section-title{
  text-align:center;
  margin:20px 0;
  font-size:27px;
}

/* WHATSAPP */
.whatsapp{
  background:#fff;
  padding:25px;
  border-radius:18px;
  text-align:center;
  box-shadow:0 5px 20px rgba(0,0,0,.08);
  margin-bottom:30px;
}

.whatsapp h2{
  margin-bottom:10px;
}

.join{
  display:inline-block;
  margin-top:18px;
  padding:13px 25px;
  background:#25D366;
  color:white;
  text-decoration:none;
  border-radius:10px;
  font-weight:bold;
}

/* PLANS */
.plans{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
  gap:15px;
}

.plan{
  background:white;
  border-radius:16px;
  padding:22px;
  text-align:center;
  box-shadow:0 5px 18px rgba(0,0,0,.08);
  border:1px solid #e7ebf0;
}

.plan h3{
  color:#0877ff;
  font-size:25px;
}

.plan p{
  margin:10px 0;
}

.plan button{
  width:100%;
  padding:12px;
  border:0;
  border-radius:9px;
  background:#0877ff;
  color:white;
  cursor:pointer;
  font-size:15px;
}

/* PAYMENT */
#paymentPage{
  display:none;
  max-width:500px;
  margin:30px auto;
  background:white;
  padding:25px;
  border-radius:18px;
  box-shadow:0 5px 25px rgba(0,0,0,.1);
}

.payment-box{
  background:#eef6ff;
  padding:18px;
  border-radius:12px;
  margin:15px 0;
}

.payment-number{
  font-size:24px;
  font-weight:bold;
  color:#0877ff;
  margin-top:5px;
}

input[type="file"]{
  width:100%;
  margin:15px 0;
}

.submit{
  width:100%;
  padding:14px;
  border:0;
  border-radius:10px;
  background:#0877ff;
  color:white;
  font-size:16px;
  cursor:pointer;
}

.back{
  margin-top:10px;
  width:100%;
  padding:12px;
  border:1px solid #ccc;
  background:white;
  border-radius:10px;
  cursor:pointer;
}

#message{
  text-align:center;
  margin-top:15px;
  font-weight:bold;
}

footer{
  text-align:center;
  padding:30px;
  color:#777;
}
</style>
</head>

<body>

<header>
  <div class="logo">SHIPOVER</div>
  <p>Simple • Fast • Transparent</p>
</header>

<div class="disclaimer">
  ⚠️ Daily earnings are not guaranteed and may be lower or higher.
  This website is a demonstration and all payments should be independently verified.
</div>

<!-- AUTOMATIC SLIDER -->
<div class="slider">
  <div class="slides">
    <div class="slide">WELCOME TO SHIPOVER</div>
    <div class="slide">FAST & SIMPLE</div>
    <div class="slide">TRANSPARENT PROCESS</div>
  </div>
</div>

<div class="container">

  <!-- WHATSAPP -->
  <div class="whatsapp">
    <h2>Join Our WhatsApp Channel</h2>
    <p>Follow SHIPOVER for updates and announcements.</p>

    <a
      class="join"
      href="https://whatsapp.com/channel/0029Vb9OYju9RZAd184WBG3L"
      target="_blank">
      Follow Shipover on WhatsApp
    </a>
  </div>

  <h2 class="section-title">Choose a Plan</h2>

  <div class="plans">

    <div class="plan">
      <h3>Rs. 300</h3>
      <p>Daily: Rs. 60</p>
      <button onclick="selectPlan(300,60)">Select Plan</button>
    </div>

    <div class="plan">
      <h3>Rs. 500</h3>
      <p>Daily: Rs. 100</p>
      <button onclick="selectPlan(500,100)">Select Plan</button>
    </div>

    <div class="plan">
      <h3>Rs. 800</h3>
      <p>Daily: Rs. 200</p>
      <button onclick="selectPlan(800,200)">Select Plan</button>
    </div>

    <div class="plan">
      <h3>Rs. 1,500</h3>
      <p>Daily: Rs. 400</p>
      <button onclick="selectPlan(1500,400)">Select Plan</button>
    </div>

    <div class="plan">
      <h3>Rs. 2,000</h3>
      <p>Daily: Rs. 500</p>
      <button onclick="selectPlan(2000,500)">Select Plan</button>
    </div>

    <div class="plan">
      <h3>Rs. 3,000</h3>
      <p>Daily: Rs. 700</p>
      <button onclick="selectPlan(3000,700)">Select Plan</button>
    </div>

    <div class="plan">
      <h3>Rs. 4,000</h3>
      <p>Daily: Rs. 1,000</p>
      <button onclick="selectPlan(4000,1000)">Select Plan</button>
    </div>

    <div class="plan">
      <h3>Rs. 5,000</h3>
      <p>Daily: Rs. 1,200</p>
      <button onclick="selectPlan(5000,1200)">Select Plan</button>
    </div>

    <div class="plan">
      <h3>Rs. 10,000</h3>
      <p>Daily: Rs. 3,000</p>
      <button onclick="selectPlan(10000,3000)">Select Plan</button>
    </div>

  </div>
</div>

<!-- PAYMENT PAGE -->
<div id="paymentPage">

  <h2>Payment Details</h2>

  <p style="margin-top:10px;">
    Selected Plan:
    <strong id="selectedPlan"></strong>
  </p>

  <div class="payment-box">
    <strong>Easypaisa Account</strong>

    <div class="payment-number">
      0305-8549554
    </div>

    <p style="margin-top:8px;">
      Account Name: <strong>Abdullah Sarfaraz</strong>
    </p>
  </div>

  <p>
    Please independently verify the payment details before sending
    any money.
  </p>

  <hr style="margin:20px 0;">

  <h3>Upload Payment Screenshot</h3>

  <input
    type="file"
    id="screenshot"
    accept="image/*">

  <button class="submit" onclick="submitPayment()">
    Submit for Verification
  </button>

  <button class="back" onclick="goBack()">
    ← Back to Plans
  </button>

  <div id="message"></div>

</div>

<footer>
  © 2026 SHIPOVER — Demo Website
</footer>

<script>

let selectedAmount = 0;
let selectedDaily = 0;

function selectPlan(amount,daily){

  selectedAmount = amount;
  selectedDaily = daily;

  document.querySelector(".container").style.display = "none";
  document.querySelector(".slider").style.display = "none";

  document.getElementById("paymentPage").style.display = "block";

  document.getElementById("selectedPlan").innerText =
    "Rs. " + amount +
    " | Possible daily amount: Rs. " + daily;

  window.scrollTo({
    top:0,
    behavior:"smooth"
  });
}

function goBack(){

  document.getElementById("paymentPage").style.display = "none";

  document.querySelector(".container").style.display = "block";
  document.querySelector(".slider").style.display = "block";

  document.getElementById("message").innerText = "";
}

function submitPayment(){

  const file =
    document.getElementById("screenshot").files[0];

  if(!file){

    document.getElementById("message").style.color = "red";

    document.getElementById("message").innerText =
      "Please upload your payment screenshot.";

    return;
  }

  document.getElementById("message").style.color = "green";

  document.getElementById("message").innerText =
    "Screenshot received. Payment is pending verification.";

  /*
    IMPORTANT:
    This demo does NOT actually upload the screenshot
    to a server.

    For a real website, send the file to a secure backend
    and verify the transaction before approving any account.
  */
}

</script>

</body>
</html>
