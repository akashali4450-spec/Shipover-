"admin/plans.php": r"""<?php
require_once __DIR__ . '/auth.php';
$message = '';

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $action = $_POST['action'] ?? '';

    if ($action === 'save') {
        $id = (int)$_POST['id'];
        $name = trim($_POST['name'] ?? '');
        $amount = (float)$_POST['amount'];
        $price = (float)$_POST['price'];
        $active = isset($_POST['active']) ? 1 : 0;
        $order = (int)$_POST['sort_order'];

        $stmt = $pdo->prepare("UPDATE plans SET name=?, amount=?, price=?, active=?, sort_order=? WHERE id=?");
        $stmt->execute([$name,$amount,$price,$active,$order,$id]);
        $message = 'Plan updated.';
    }

    if ($action === 'add') {
        $stmt = $pdo->prepare("INSERT INTO plans (name,amount,price,active,sort_order) VALUES (?,?,?,?,?)");
        $stmt->execute([
            trim($_POST['name'] ?? 'New Plan'),
            (float)$_POST['amount'],
            (float)$_POST['price'],
            1,
            (int)$_POST['sort_order']
        ]);
        $message = 'Plan added.';
    }

    if ($action === 'delete') {
        $stmt = $pdo->prepare("DELETE FROM plans WHERE id=?");
        $stmt->execute([(int)$_POST['id']]);
        $message = 'Plan deleted.';
    }
}
$plans = $pdo->query("SELECT * FROM plans ORDER BY sort_order,id")->fetchAll();
require __DIR__ . '/header.php';
?>
